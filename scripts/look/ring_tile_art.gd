## Look B tile art for the polar world (docs/art-direction.md, "Life of a Worm: final look").
## A TileArt (addons/openjar/tileworld) whose TileSet is the autotile mask atlas
## `assets/sprites/world/tile_masks.png`: one row per material, one column per open mask (16), and
## for grassy materials four more blocks of 16 with grass blades on the side that faces away from
## the core. Every tile shares one ShaderMaterial (assets/shaders/ring_tiles.gdshader) that paints
## the material's seamless texture and normal map in world space. Generated by
## scripts/look/gen/make_world.py; materials.json maps RingSet tile names onto materials.
class_name RingTileArt
extends TileArt

const MANIFEST := "res://assets/sprites/world/materials.json"
const MASKS := preload("res://assets/sprites/world/tile_masks.png")
const MATS := preload("res://assets/sprites/world/materials.png")
const MATS_N := preload("res://assets/sprites/world/materials_n.png")
const CASTINGS := preload("res://assets/sprites/world/castings.png")
const SHADER := preload("res://assets/shaders/ring_tiles.gdshader")

var material: ShaderMaterial
var collision_layer := 1
## tile id -> material row; tile id -> 1 if it grows grass on its outward side.
var _row := PackedInt32Array()
var _grassy := PackedByteArray()
var _solid := PackedByteArray()
var _grassy_rows: Array[int] = []
var _rows := 0


func _init(palette: Array[TileDef] = [], p_collision_layer := 1) -> void:
	collision_layer = p_collision_layer
	var man: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(MANIFEST))
	var mats: Array = man.materials
	_rows = mats.size()
	for gname in man.grassy:
		_grassy_rows.append(mats.find(gname))
	_row.resize(palette.size())
	_grassy.resize(palette.size())
	_solid.resize(palette.size())
	for i in palette.size():
		var d := palette[i]
		var mname: String = man.tiles.get(String(d.id), "") if d else ""
		_row[i] = maxi(mats.find(mname), 0)
		_grassy[i] = 1 if _grassy_rows.has(_row[i]) else 0
		_solid[i] = 1 if d and d.solid and i > 0 else 0
	material = ShaderMaterial.new()
	material.shader = SHADER
	material.set_shader_parameter("mats", MATS)
	material.set_shader_parameter("mats_n", MATS_N)
	material.set_shader_parameter("mat_size", float(man.size))
	material.set_shader_parameter("mat_count", float(_rows))


func material_of(id: int) -> int:
	return _row[id] if id >= 0 and id < _row.size() else -1


func tile_set() -> TileSet:
	var ts := TileSet.new()
	ts.tile_size = Vector2i(16, 16)
	ts.add_physics_layer()
	ts.set_physics_layer_collision_layer(0, collision_layer)
	var src := TileSetAtlasSource.new()
	src.texture = MASKS
	src.texture_region_size = Vector2i(16, 16)
	ts.add_source(src, SOLID_SOURCE)
	var square := PackedVector2Array([Vector2(-8, -8), Vector2(8, -8), Vector2(8, 8), Vector2(-8, 8)])
	for row in _rows:
		var blocks := 5 if _grassy_rows.has(row) else 1
		for col in blocks * 16:
			var at := Vector2i(col, row)
			src.create_tile(at)
			var td := src.get_tile_data(at, 0)
			td.material = material
			td.add_collision_polygon(0)
			td.set_collision_polygon_points(0, 0, square)
	return ts


func solid_coords(cell: Vector2i, id: int, open: int) -> Vector2i:
	var row := material_of(id)
	var side := 0
	if row >= 0 and _grassy[id] == 1:
		side = outward_side(cell)
	return Vector2i(side * 16 + open, maxi(row, 0))


func wall_coords(_cell: Vector2i, _base_id: int, _ceiling: bool) -> Vector2i:
	return NO_TILE  # dug cells show the castings layer and the soil parallax behind it


## 1 up, 2 right, 3 down, 4 left: the side of the cell that faces away from the core (cell 0,0).
static func outward_side(cell: Vector2i) -> int:
	var v := Vector2(cell) + Vector2(0.5, 0.5)
	if absf(v.y) >= absf(v.x):
		return 1 if v.y < 0.0 else 3
	return 2 if v.x > 0.0 else 4


## The tunnel floor under eaten cells: a translucent dark wash with crumbs, four variants.
func castings_tile_set() -> TileSet:
	var ts := TileSet.new()
	ts.tile_size = Vector2i(16, 16)
	var src := TileSetAtlasSource.new()
	src.texture = CASTINGS
	src.texture_region_size = Vector2i(16, 16)
	ts.add_source(src, 0)
	for v in 4:
		src.create_tile(Vector2i(v, 0))
	return ts
