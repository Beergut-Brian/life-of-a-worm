{
	"id": "opening",
	"scene": "dock",
	"title": "The one that got away",
	"when": "start (stage 1)",
	"time_of_day": "dawn",
	"clue": "Strangestone glows under the bait tin; Gulp and Burp plop into the dirt",
	"steps": [
		{"do": "call", "fn": "time", "args": {"of": "dawn", "secs": 0}},
		{"do": "camera", "to": "wide", "zoom": 2.6, "time": 0.05, "wait": 0.05},
		{"do": "sound", "cue": "story_water"},
		{"do": "wait", "time": 2.5},
		{"do": "camera", "to": "dock", "zoom": 4.2, "time": 2.6, "wait": 2.4},
		{"do": "line", "who": "Bobber", "line": "op_bobber_why", "pics": ["sandwich", "question"]},
		{"do": "face", "who": "Reel", "toward": "Bobber"},
		{"do": "line", "who": "Reel", "line": "op_reel_worms", "pics": ["worm", "face_happy"]},
		{"do": "call", "fn": "hands", "args": {"who": "Reel", "w": 5, "secs": 0.4}},
		{"do": "line", "who": "Reel", "line": "op_reel_this_big", "pics": ["worm_tiny", "hook"]},
		{"do": "call", "fn": "pose", "args": {"who": "Bobber", "pose": "squint"}},
		{"do": "line", "who": "Bobber", "line": "op_bobber_tiny", "pics": ["worm_tiny", "face_sheepish"]},
		{"do": "call", "fn": "hands", "args": {"who": "Reel", "w": 0, "secs": 0.4}},
		{"do": "call", "fn": "pose", "args": {"who": "Bobber", "pose": "idle"}},
		{"do": "camera", "to": "bank", "zoom": 4.4, "time": 2.0, "dx": 40},
		{"do": "line", "who": "Reel", "line": "op_reel_one_morning", "pics": ["dock", "sparkle"]},
		{"do": "fade", "to": 1, "time": 0.6},
		{"do": "call", "fn": "warm", "args": {"on": true, "secs": 0}},
		{"do": "hide", "who": "Reel"},
		{"do": "hide", "who": "Bobber"},
		{"do": "show", "who": "YoungReel"},
		{"do": "show", "who": "Gulp"},
		{"do": "show", "who": "Burp"},
		{"do": "camera", "to": "hook", "zoom": 4.8, "time": 0.05, "dx": -56, "dy": 0, "wait": 0.05},
		{"do": "walk", "who": "YoungReel", "to": "shed", "dx": 24, "time": 0.05},
		{"do": "fade", "to": 0, "time": 0.8},
		{"do": "walk", "who": "YoungReel", "to": "bank", "time": 2.4},
		{"do": "sound", "cue": "story_hum"},
		{"do": "line", "who": "YoungReel", "line": "op_reel_young_hum", "pics": ["hook", "fish"]},
		{"do": "hop", "who": "Gulp", "height": 2, "times": 2, "time": 0.25, "sound": "story_wriggle"},
		{"do": "hop", "who": "Burp", "height": 2, "times": 2, "time": 0.25},
		{"do": "line", "who": "YoungReel", "line": "op_reel_two_of_em", "pics": ["worm_two"]},
		{"do": "line", "who": "YoungReel", "line": "op_reel_names", "pics": ["worm_two", "face_happy"]},
		{"do": "bubble", "who": "Burp", "pics": ["burp"], "time": 1.4, "then": true},
		{"do": "sound", "cue": "story_burp"},
		{"do": "line", "who": "Bobber", "line": "op_bobber_burp", "pics": ["burp"]},
		{"do": "hop", "who": "Gulp", "height": 3, "times": 3, "time": 0.2, "sound": "story_wriggle"},
		{"do": "hop", "who": "Burp", "height": 3, "times": 3, "time": 0.2},
		{"do": "wait", "time": 0.7},
		{"do": "walk", "who": "Gulp", "to": "plop", "dx": -4, "time": 0.5, "fly": true, "then": true},
		{"do": "walk", "who": "Burp", "to": "plop", "dx": 4, "time": 0.5, "fly": true},
		{"do": "sound", "cue": "story_plop"},
		{"do": "wait", "time": 0.8},
		{"do": "line", "who": "YoungReel", "line": "op_reel_got_away", "pics": ["worm_two", "face_sheepish"]},
		{"do": "camera", "to": "burrow", "zoom": 5.0, "time": 3.4, "dy": -12},
		{"do": "walk", "who": "Gulp", "to": "burrow", "dx": -6, "time": 3.4, "fly": true, "then": true},
		{"do": "walk", "who": "Burp", "to": "burrow", "dx": 8, "time": 3.4, "fly": true},
		{"do": "sound", "cue": "story_dig"},
		{"do": "line", "who": "Gulp", "line": "op_reel_hungry", "pics": ["eat", "worm_big"]},
		{"do": "hop", "who": "Gulp", "height": 3, "times": 2, "time": 0.25, "sound": "story_gulp"},
		{"do": "hop", "who": "Burp", "height": 3, "times": 2, "time": 0.25},
		{"do": "wait", "time": 1.5},
		{"do": "call", "fn": "warm", "args": {"on": false, "secs": 0.8}},
		{"do": "fade", "to": 1, "time": 0.8},
		{"do": "call", "fn": "handoff", "args": {"what": "follow_worm_underground"}, "always": true}
	]
}
