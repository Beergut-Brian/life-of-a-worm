[gd_resource type="Resource" script_class="TrophyFamily" format=3]

[ext_resource type="Script" path="res://scripts/burrow/trophy_family.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"snacks"
members = Array[StringName]([&"seed", &"grub", &"root", &"mushroom", &"apple", &"golden_acorn", &"honeydew", &"crumb", &"jam_drop", &"party_sweet", &"ship_biscuit", &"bug_egg", &"twig", &"turf", &"plank", &"crate_chunk", &"carrot_tip", &"potato", &"wild_berry", &"cherry_pit", &"clover_leaf", &"walnut"])
per_trophy = {"speed": 3.0}
cap = 3
color = Color(0.45, 0.8, 0.35, 1)
charm = &"leaf"
