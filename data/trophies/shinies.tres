[gd_resource type="Resource" script_class="TrophyFamily" format=3]

[ext_resource type="Script" path="res://scripts/burrow/trophy_family.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"shinies"
members = Array[StringName]([&"crystal", &"bottle_cap", &"droplet", &"amber", &"geode_heart", &"core_crystal", &"scrap", &"balloon_tie", &"sky_balloon", &"toy_plane", &"rainbow_drop", &"cloud_puff", &"milk_drop", &"marble", &"button", &"old_spoon", &"lost_coin", &"glass_bead", &"crayon", &"toy_car", &"tin_can", &"garden_glove", &"rubber_duck", &"pickle", &"pick_head", &"cave_pearl", &"salt_crystal", &"spring_bubble", &"miner_lamp", &"cart_wheel", &"rail_spike", &"fire_opal", &"glow_seed", &"magma_bubble", &"watermelon", &"newspaper", &"garden_gnome", &"bird_house", &"kite", &"soap_bubble", &"dandelion_puff", &"snowflake", &"bathtub", &"rusty_anchor", &"old_piano", &"hot_air_balloon", &"rain_cloud", &"blimp", &"star_chip", &"magma_gem", &"time_capsule", &"old_wheelbarrow"])
